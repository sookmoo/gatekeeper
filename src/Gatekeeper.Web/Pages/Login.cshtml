@page
@model Gatekeeper.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
@if (Model.Ended)
{
    <p class="notice">Your session ended. Please sign in again.</p>
}
@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}
<form method="post">
    <label>Username
        <input name="Username" value="@Model.Username" maxlength="256" autocomplete="username" required autofocus>
    </label>
    <label>Password
        <input name="Password" type="password" maxlength="1024" autocomplete="current-password" required>
    </label>
    <button type="submit">Sign in</button>
</form>
