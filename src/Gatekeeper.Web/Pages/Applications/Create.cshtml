@page
@model Gatekeeper.Web.Pages.Applications.CreateModel
@{
    ViewData["Title"] = "New application";
}
<h1>New application</h1>
@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}
<form method="post">
    <label>Name
        <input name="Name" value="@Model.Name" maxlength="64" required autofocus>
    </label>
    <button type="submit">Create</button>
    <a href="/Applications">Cancel</a>
</form>
