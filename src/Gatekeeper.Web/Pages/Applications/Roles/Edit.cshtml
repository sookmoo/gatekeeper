@page "/Applications/{appId:guid}/Roles/Edit/{id:guid}"
@model Gatekeeper.Web.Pages.Applications.Roles.EditModel
@{
    ViewData["Title"] = "Edit role";
}
<h1>Edit role of @Model.App.Name</h1>
@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}
@if (Model.ReadOnly)
{
    <p class="hint">This application is reserved: its roles are read-only.</p>
    <p><a href="/Applications/@Model.App.Id/Roles">Back</a></p>
}
else
{
    <form method="post">
        <input type="hidden" name="Version" value="@Model.HiddenVersion">
        <label>Name
            <input name="Name" value="@Model.Name" maxlength="64" required autofocus>
        </label>
        <label>Description
            <input name="Description" value="@Model.Description" maxlength="256">
        </label>
        <button type="submit">Save</button>
        <a href="/Applications/@Model.App.Id/Roles">Cancel</a>
    </form>
}
