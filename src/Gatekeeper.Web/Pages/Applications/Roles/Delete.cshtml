@page "/Applications/{appId:guid}/Roles/Delete/{id:guid}"
@model Gatekeeper.Web.Pages.Applications.Roles.DeleteModel
@{
    ViewData["Title"] = "Delete role";
}
<h1>Delete role</h1>
@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}
@if (Model.ReadOnly)
{
    <p class="hint">This application is reserved: its roles are read-only.</p>
    <p><a href="/Applications/@Model.App.Id/Roles">Back</a></p>
}
else
{
    <p>Delete role <strong>@Model.Role.Name</strong> of <strong>@Model.App.Name</strong>? It is also removed from every user and service client that holds it, and this cannot be undone.</p>
    <form method="post">
        <input type="hidden" name="Version" value="@Model.HiddenVersion">
        <button type="submit" class="danger">Delete</button>
        <a href="/Applications/@Model.App.Id/Roles">Cancel</a>
    </form>
}
