@page "/Users/{id:guid}/Password"
@model Gatekeeper.Web.Pages.Users.PasswordModel
@{
    ViewData["Title"] = "Set password";
}
<h1>Set password for @Model.Target.Username</h1>
@if (Model.Done is not null)
{
    <p class="notice">@Model.Done</p>
}
@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}
@if (Model.IsSelf)
{
    <p class="error" role="alert">This is your own account. Changing the password ends your sign-in sessions, and you sign in again with the new one.</p>
}
<form method="post" autocomplete="off">
    <label>New password
        <input name="Password" type="password" autocomplete="new-password" minlength="@UserAccess.PasswordMin" maxlength="@UserAccess.PasswordMax" required autofocus>
    </label>
    <label>Repeat the password
        <input name="Confirm" type="password" autocomplete="new-password" minlength="@UserAccess.PasswordMin" maxlength="@UserAccess.PasswordMax" required>
    </label>
    <p class="hint">12 to 128 characters. Setting a password ends the user's sign-in (refresh) sessions. Access tokens already issued stay valid until they expire (up to 15 minutes) unless the receiving application checks with the API.</p>
    <button type="submit">Set password</button>
    <a href="/Users/@Model.Target.Id/Roles">Roles of this user</a>
    <a href="/Users">Cancel</a>
</form>
