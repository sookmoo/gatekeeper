@model Gatekeeper.Web.Pages.Clients.SecretView
<h1>@(Model.Rotated ? "New secret for" : "Client created:") @Model.ClientName</h1>
<p class="notice"><strong>Copy it now, it is shown once.</strong> Gatekeeper keeps only a hash and cannot show this secret again.</p>
<label>Secret
    <input name="secret" value="@Model.Secret" readonly autocomplete="off" spellcheck="false" autocapitalize="off">
</label>
@if (Model.Rotated)
{
    <p class="hint">The old secret no longer works. Access tokens already issued stay valid until they expire (introspection while the client is active, local validation always). If the old secret leaked, keep the client disabled until the access-token lifetime has passed.</p>
}
else
{
    <p class="hint">The client signs in with its name and this secret. It can only get a token once it holds a role of its application.</p>
}
<p class="hint">Do not reload this page and do not resubmit it. Your browser may offer to resend the form when you go back or reload:
    Gatekeeper refuses such a resubmit and does not call the API again, but you would lose this page: the secret is not shown a second time.
    Leave with the link below instead.</p>
<p><a class="button" href="/Clients">Back to clients</a></p>
