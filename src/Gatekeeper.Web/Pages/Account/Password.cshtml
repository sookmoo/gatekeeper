@page "/Account/Password"
@model Gatekeeper.Web.Pages.Account.PasswordModel
@using Gatekeeper.Web.Pages.Users
@{
    ViewData["Title"] = "Change password";
}
<h1>Change password</h1>
@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}
<form method="post">
    <label>Current password
        <input name="Current" type="password" autocomplete="current-password" maxlength="@UserAccess.PasswordMax" required autofocus>
    </label>
    <label>New password
        <input name="New" type="password" autocomplete="new-password" minlength="@UserAccess.PasswordMin" maxlength="@UserAccess.PasswordMax" required>
    </label>
    <label>Repeat the new password
        <input name="Confirm" type="password" autocomplete="new-password" minlength="@UserAccess.PasswordMin" maxlength="@UserAccess.PasswordMax" required>
    </label>
    <p class="hint">12 to 128 characters. Changing the password ends all your other sign-in sessions; this one stays.</p>
    <button type="submit">Change password</button>
    <a href="/Account">Cancel</a>
</form>
