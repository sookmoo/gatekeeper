[Unit]
Description=Gatekeeper API
Requires=gatekeeper-migrate.service
After=gatekeeper-migrate.service

[Container]
ContainerName=gatekeeper-api
Image=ghcr.io/sookmoo/gatekeeper:latest
Network=gatekeeper.network
# Loopback only on the host: the API speaks plain HTTP (passwords, tokens). Put a TLS proxy in front to expose it.
PublishPort=127.0.0.1:5080:8080
Environment=Store__Provider=Postgres
Environment=Gatekeeper__AllowNonLoopback=true
# The UI calls the API by its container name, so that Host name must be allowed next to the loopback ones.
Environment="AllowedHosts=localhost;127.0.0.1;[::1];gatekeeper-api"
# Data-only role: the running service holds no DDL rights.
Secret=gatekeeper-conn-app,type=env,target=ConnectionStrings__Gatekeeper
# ES256 private key (PEM) that signs access tokens; the public half is served at /.well-known/jwks.json.
# Mounted as a file (not an environment variable) so it does not show up in `podman inspect` or /proc/<pid>/environ.
Secret=gatekeeper-signing-key,type=mount,uid=1654,mode=0400
Environment=Auth__SigningKeyPemFile=/run/secrets/gatekeeper-signing-key
# Public keys of earlier signing keys (PEM blocks), published in the JWKS until the tokens they signed have expired.
# Managed by deploy/rotate-signing-key.sh; "# no retired keys" when empty.
Secret=gatekeeper-retired-keys,type=mount,uid=1654,mode=0400
Environment=Auth__RetiredKeysPemFile=/run/secrets/gatekeeper-retired-keys
# The root filesystem is read-only, so give the secret a writable place to be mounted into.
Tmpfs=/run/secrets:size=1m,mode=0755
# Argon2 uses 64 MiB per hash and the service caps concurrent hashes; this is a backstop against exhausting the host.
PodmanArgs=--memory=768m
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
# JSON form: the chiseled image has no shell for CMD-SHELL.
HealthCmd=["dotnet", "Gatekeeper.Api.dll", "healthcheck"]
HealthInterval=30s
HealthStartPeriod=10s
HealthRetries=3

[Service]
Restart=always

[Install]
WantedBy=default.target
